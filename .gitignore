# Ignore backup
/TranslateTest/

# Ignore user-specific layout and workspace states
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/workspace.json.bak

# Ignore Obsidian trash
/.trash/

# Ignore OS files
.DS_Store
Thumbs.db

# Plugins: only the ones listed with ! below get uploaded. Everything else people install stays on their own computer.
# To share a new plugin with everyone, add a line like: !.obsidian/plugins/plugin-folder-name/
.obsidian/plugins/*
!.obsidian/plugins/obsidian-git/
!.obsidian/plugins/various-complements/
!.obsidian/plugins/colored-text/

# Ignore personal suggestion history (different on every computer)
.obsidian/plugins/various-complements/histories.json

# Ignore personal look of Obsidian (theme, font size, etc.)
.obsidian/appearance.json
